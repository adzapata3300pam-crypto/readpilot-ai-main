# ReadPilot web-root protection.
#
# NOTE: the php:8.3-apache image ships with "AllowOverride None", so this file
# is ignored inside Docker. The container gets the identical rules from
# /etc/apache2/conf-available/readpilot-security.conf (see Dockerfile), which
# cannot be bypassed by a stray htaccess. Keep both in sync.

Options -Indexes -MultiViews

# Never serve dotfiles (.git, .env, .htpasswd, ...).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Never serve build/deploy artefacts or the schema dump.
<FilesMatch "^(database\.sql|composer\.(json|lock)|Dockerfile|php\.ini|readpilot\.secrets.*\.php|.*\.example\.php|.*\.md|\.dockerignore|\.gitignore)$">
    Require all denied
</FilesMatch>

# Dependencies are server-side only.
RedirectMatch 404 ^/vendor/.*$

# Security headers. HSTS is added by the platform on HTTPS.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# uploader/ lives in the web root so that profile images keep working for any
# rows still pointing at the pre-Supabase local paths. Script execution there is
# disabled by uploads/.htaccess, since <Directory> is not permitted in .htaccess.

DirectoryIndex index.php index.html